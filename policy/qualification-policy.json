{
  "schema": "fastner-benchmarks.policy/1",
  "policy_version": "0.2.0",
  "status": "alpha-1",
  "no_single_score": true,
  "forbidden_aggregate_keys": [
    "score",
    "overall_score",
    "composite",
    "composite_score",
    "universal_score",
    "rank_score",
    "weighted_score"
  ],
  "missing_value_rule": "unavailable-is-never-zero",
  "decision_method": "pareto-frontier",
  "dimensions": [
    {
      "id": "entity_precision",
      "group": "quality",
      "title": "Entity precision (public snapshot)",
      "direction": "max",
      "unit": "ratio",
      "source": {
        "artifact": "quality",
        "population": "ner-evidence-public",
        "metric": "precision",
        "slice": null,
        "match": "strict"
      }
    },
    {
      "id": "entity_recall",
      "group": "quality",
      "title": "Entity recall (public snapshot)",
      "direction": "max",
      "unit": "ratio",
      "source": {
        "artifact": "quality",
        "population": "ner-evidence-public",
        "metric": "recall",
        "slice": null,
        "match": "strict"
      }
    },
    {
      "id": "entity_f1",
      "group": "quality",
      "title": "Entity F1 (public snapshot)",
      "direction": "max",
      "unit": "ratio",
      "source": {
        "artifact": "quality",
        "population": "ner-evidence-public",
        "metric": "f1",
        "slice": null,
        "match": "strict"
      }
    },
    {
      "id": "ambiguous_name_precision",
      "group": "quality",
      "title": "Ambiguous-name precision",
      "direction": "max",
      "unit": "ratio",
      "source": {
        "artifact": "quality",
        "population": "ner-evidence-public",
        "metric": "precision",
        "slice": "difficulty=ambiguous",
        "match": "strict"
      }
    },
    {
      "id": "unseen_name_recall",
      "group": "quality",
      "title": "Unseen-name recall",
      "direction": "max",
      "unit": "ratio",
      "source": {
        "artifact": "quality",
        "population": "ner-evidence-public",
        "metric": "recall",
        "slice": "seen=false",
        "match": "strict"
      }
    },
    {
      "id": "en_f1",
      "group": "language",
      "title": "English F1",
      "direction": "max",
      "unit": "ratio",
      "source": {
        "artifact": "quality",
        "population": "ner-evidence-public",
        "metric": "f1",
        "slice": "language=en",
        "match": "strict"
      }
    },
    {
      "id": "ko_f1",
      "group": "language",
      "title": "Korean F1",
      "direction": "max",
      "unit": "ratio",
      "source": {
        "artifact": "quality",
        "population": "ner-evidence-public",
        "metric": "f1",
        "slice": "language=ko",
        "match": "strict"
      }
    },
    {
      "id": "single_token_recall",
      "group": "shape",
      "title": "Single-token name recall",
      "direction": "max",
      "unit": "ratio",
      "source": {
        "artifact": "quality",
        "population": "ner-evidence-public",
        "metric": "recall",
        "slice": "shape=single-token",
        "match": "strict"
      }
    },
    {
      "id": "multi_token_f1",
      "group": "shape",
      "title": "Multi-token name F1",
      "direction": "max",
      "unit": "ratio",
      "source": {
        "artifact": "quality",
        "population": "ner-evidence-public",
        "metric": "f1",
        "slice": "shape=multi-token",
        "match": "strict"
      }
    },
    {
      "id": "collision_precision_worst",
      "group": "collision",
      "title": "Worst collision-slice precision",
      "direction": "max",
      "unit": "ratio",
      "source": {
        "artifact": "quality",
        "population": "ner-evidence-public",
        "metric": "precision",
        "slice_prefix": "collision=",
        "reduce": "min",
        "match": "strict"
      }
    },
    {
      "id": "latency_p95_ms",
      "group": "performance",
      "title": "Warm latency p95",
      "direction": "min",
      "unit": "ms",
      "source": {
        "artifact": "perf",
        "field": "summary.latency_p95_ms"
      }
    },
    {
      "id": "throughput_docs_per_s",
      "group": "performance",
      "title": "Batch throughput",
      "direction": "max",
      "unit": "docs/s",
      "source": {
        "artifact": "perf",
        "field": "summary.throughput_docs_per_s"
      }
    },
    {
      "id": "startup_ms",
      "group": "performance",
      "title": "Cold startup",
      "direction": "min",
      "unit": "ms",
      "source": {
        "artifact": "perf",
        "field": "summary.startup_ms"
      }
    },
    {
      "id": "peak_memory_mb",
      "group": "performance",
      "title": "Peak memory",
      "direction": "min",
      "unit": "MiB",
      "source": {
        "artifact": "perf",
        "field": "summary.peak_rss_mb"
      }
    },
    {
      "id": "model_size_bytes",
      "group": "size",
      "title": "Model artifact size",
      "direction": "min",
      "unit": "bytes",
      "source": {
        "artifact": "perf",
        "field": "summary.model_size_bytes"
      }
    },
    {
      "id": "runtime_binary_size_bytes",
      "group": "size",
      "title": "Runtime binary size",
      "direction": "min",
      "unit": "bytes",
      "source": {
        "artifact": "perf",
        "field": "summary.binary_size_bytes"
      }
    },
    {
      "id": "wasm_size_bytes",
      "group": "size",
      "title": "WASM size",
      "direction": "min",
      "unit": "bytes",
      "source": {
        "artifact": "perf",
        "field": "summary.wasm_size_bytes"
      }
    }
  ],
  "quality_match_mode": "strict",
  "quality_match_note": "Dimensions use ner-eval strict (exact span + type) metrics. Boundary-lenient metrics are shown beside them in reports but never substituted, so boundary defects stay visible.",
  "perf_summary": {
    "threads": 1,
    "latency_batch": 1,
    "definitions": {
      "latency_p95_ms": "per-case warm p95 at batch size 1, 1 thread",
      "throughput_docs_per_s": "cases/s at the largest measured batch, 1 thread",
      "startup_ms": "median cold startup at batch size 1, 1 thread",
      "peak_rss_mb": "max peak RSS over 1-thread cells (scope recorded per artifact)",
      "model_size_bytes": "role=model artifact",
      "binary_size_bytes": "role=binary artifact (shared shim for all FastNER candidates)",
      "wasm_size_bytes": "role=wasm artifact (per-candidate probe module)"
    }
  },
  "min_slice_cases": 50
}
