{
  "schema": "fastner-benchmarks.support-gates/1",
  "gate_set_version": "0.3.0",
  "policy_version": "0.2.0",
  "statuses": [
    "unsupported",
    "experimental",
    "provisional",
    "stable"
  ],
  "status_definitions": {
    "unsupported": "No selected architecture, or nothing measured for this profile. Never means 'bad'; means 'no evidence'.",
    "experimental": "A candidate is measured for this profile but at least one gate fails/is unmeasured, or the architecture is not yet promoted via ADR, or the gate set is not ratified.",
    "provisional": "Selected architecture promoted (ADR recorded), pins resolved, every gate passes, gate set ratified against a real baseline.",
    "stable": "Not reachable at Alpha. Requires stable_requirements below."
  },
  "thresholds_status": "ratified-as-beta-targets",
  "ratification": {
    "baseline_run_ids": [
      "run-395459fbb4ecb4da",
      "run-fa7c74ef7884624a",
      "run-810f86b911170c68"
    ],
    "by": "fastner-benchmarks maintainer role, exercised by Claude Code under the project owner's standing instruction to decide without further confirmation",
    "date": "2026-10-04",
    "decision": "Thresholds are adopted unchanged as the targets Beta must reach for `provisional`. They were NOT fitted to the baseline: CRF fails most quality gates, which is the intended Beta backlog.",
    "scope_and_limits": [
      "Baseline = one public snapshot that is not a holdout and was run against successive FastNER builds, plus two tiny seed product corpora (52 and 37 cases).",
      "Ratification does not make anything provisional: every gate must pass, with an accepted ADR on fastner main.",
      "Re-ratify, with revised numbers if needed, when a protected holdout exists and before any move toward stable.",
      "Startup/latency/throughput gates are ratified with a measurement caveat: ner-eval measures them through an external-process shim."
    ]
  },
  "ratification_rule": "Adopted thresholds are targets, not claims. A profile becomes provisional only when every gate passes, the ADR is on fastner main, and this ratification record exists.",
  "stable_enabled": false,
  "stable_requirements": [
    "stable_enabled=true (policy decision after Beta evidence)",
    "holdout population measured (private aggregates)",
    "gates passing in >= 2 consecutive requalifications",
    "budgets enforced in CI"
  ],
  "profiles": [
    {
      "id": "PERSON/en",
      "entity": "PERSON",
      "language": "en",
      "required_populations": [
        "ner-evidence-public",
        "fastner-regression",
        "fastner-adversarial"
      ],
      "gates": [
        {
          "id": "public.en_f1",
          "title": "EN F1 on public snapshot",
          "op": ">=",
          "threshold": 0.85,
          "source": {
            "dimension": "en_f1"
          }
        },
        {
