{
  "schema": "fastner-benchmarks.support-gates/1",
  "gate_set_version": "0.2.0",
  "policy_version": "0.2.0",
  "statuses": [
    "unsupported",
    "experimental",
    "provisional",
    "stable"
  ],
  "status_definitions": {
    "unsupported": "No selected architecture, or nothing measured for this profile. Never means 'bad'; means 'no evidence'.",
    "experimental": "A candidate is measured for this profile but at least one gate fails/is unmeasured, or the architecture is not yet promoted via ADR, or the gate set is not ratified.",
    "provisional": "Selected architecture promoted (ADR recorded), pins resolved, every gate passes, gate set ratified against a real baseline.",
    "stable": "Not reachable at Alpha. Requires stable_requirements below."
  },
  "thresholds_status": "proposed-unratified",
  "ratification": null,
  "ratification_rule": "No baseline measurements exist, so every number below is a PROPOSAL. A profile cannot become provisional until `ratification` records the baseline run ids and who ratified; until then the generator caps support at experimental.",
  "stable_enabled": false,
  "stable_requirements": [
    "stable_enabled=true (policy decision after Beta evidence)",
    "holdout population measured (private aggregates)",
    "gates passing in >= 2 consecutive requalifications",
    "budgets enforced in CI"
  ],
  "profiles": [
    {
      "id": "PERSON/en",
